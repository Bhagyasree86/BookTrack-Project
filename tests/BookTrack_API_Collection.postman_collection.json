{
  "info": {
    "_postman_id": "7b8972e2-1a48-4e89-a2e6-booktrack001",
    "name": "BookTrack API Collection",
    "description": "Comprehensive REST API test collection for BookTrack Library Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Books - Get All Books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      },
      "response": []
    },
    {
      "name": "02. Books - Add New Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.environment.set('bookId', jsonData.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Domain-Driven Design: Tackling Complexity in Software\",\n  \"author\": \"Eric Evans\",\n  \"isbn\": \"9780321125217\",\n  \"category\": \"Software Architecture\",\n  \"quantity\": 5,\n  \"availableCopies\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      },
      "response": []
    },
    {
      "name": "03. Books - Search Books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/search?keyword=Domain",
          "host": ["{{baseUrl}}"],
          "path": ["books", "search"],
          "query": [{ "key": "keyword", "value": "Domain" }]
        }
      },
      "response": []
    },
    {
      "name": "04. Books - Update Book",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Domain-Driven Design (Reference Edition)\",\n  \"author\": \"Eric Evans\",\n  \"isbn\": \"9780321125217\",\n  \"category\": \"Software Architecture\",\n  \"quantity\": 6,\n  \"availableCopies\": 6\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["books", "{{bookId}}"]
        }
      },
      "response": []
    },
    {
