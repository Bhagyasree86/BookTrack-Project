    {
      "name": "07. Borrow - Issue Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.environment.set('loanId', jsonData.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": {{bookId}},\n  \"studentId\": {{studentId}},\n  \"dueDate\": \"2026-11-05\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/borrow-records/issue",
          "host": ["{{baseUrl}}"],
          "path": ["borrow-records", "issue"]
        }
      },
      "response": []
    },
    {
      "name": "08. Borrow - Return Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
